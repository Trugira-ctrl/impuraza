# Postman environment holds real credentials once you fill it in (the committed copy
# is a blank template) - re-exporting from Postman would overwrite it with real values
postman/Impuruza.postman_environment.json

# Generated HTML dashboard - a snapshot of live operational counts (disease/location
# names, signal volumes) that goes stale immediately. Commit scripts/build_html_dashboard.py,
# not its output; regenerate locally with `python3 scripts/build_html_dashboard.py`.
dashboard/
