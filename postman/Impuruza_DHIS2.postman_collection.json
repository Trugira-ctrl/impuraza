{
  "info": {
    "_postman_id": "946afeb0-652c-4750-9cde-3b2f16a09144",
    "name": "Impuruza (cbs2.moh.gov.rw) - DHIS2 Tracker API",
    "description": "Requests mirroring the exploration done in scripts/ and docs/API_NOTES.md for the Rwanda MoH 'Impuruza' community event-based surveillance (CEBS) program. Import the companion environment (Impuruza.postman_environment.json), fill in {{username}}/{{password}}, and select it before running requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "programId", "value": "oWvNtR6iP8p", "description": "Impuruza program" },
    { "key": "orgUnitId", "value": "Hjw70Lodtf2", "description": "Rwanda (root org unit)" },
    { "key": "programStageId", "value": "AXUtIJGHw0H", "description": "Impuruza CEBS program stage" },
    { "key": "optionSetId", "value": "u6DycA2BPZS", "description": "'Signal Verification' option set (Confirmed/Discarded)" },
    { "key": "notificationTemplateId", "value": "QKLpmgjNYX7", "description": "'Ubutumwa ecs' template - the only notification wired to this program stage" },
    { "key": "trackedEntityIdsCsv", "value": "", "description": "Comma-separated trackedEntity ids, e.g. from a tracker/events response, for the batch reporter-details lookup" },
    { "key": "orgUnitIdsCsv", "value": "", "description": "Comma-separated org unit ids for the batch name-resolution lookup" },
    { "key": "updatedAfter", "value": "", "description": "ISO datetime (server-local time, e.g. 2026-08-26T10:00:00.000) for incremental event queries" },
    { "key": "searchTerm", "value": "ceho", "description": "Free-text term for role/group metadata searches" }
  ],
  "item": [
    {
      "name": "1. Auth & System",
      "item": [
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/me.json?fields=id,username,name,authorities,organisationUnits[id,name]",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me.json"],
              "query": [
                { "key": "fields", "value": "id,username,name,authorities,organisationUnits[id,name]" }
              ]
            },
            "description": "Confirms credentials work and shows the account's org unit scope. Should return HTTP 200 with your username."
          }
        },
        {
          "name": "System info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/system/info.json?fields=version,revision,serverDate,contextPath,calendar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "system", "info.json"],
              "query": [
                { "key": "fields", "value": "version,revision,serverDate,contextPath,calendar" }
              ]
            },
            "description": "DHIS2 version + the server's own clock. Note: serverDate is Rwanda local time (UTC+2), not UTC - confirmed by comparing against local machine time."
          }
        }
      ]
    },
    {
      "name": "2. Program Metadata",
      "item": [
        {
          "name": "Program schema (Impuruza)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/programs/{{programId}}.json?fields=id,name,programType,trackedEntityType[id,name],programTrackedEntityAttributes[mandatory,displayInList,sortOrder,trackedEntityAttribute[id,name,valueType,optionSet[id,name]]],programStages[id,name,programStageDataElements[compulsory,dataElement[id,name,valueType,optionSet[id,name]]]]",
              "host": ["{{baseUrl}}"],
              "path": ["api", "programs", "{{programId}}.json"],
              "query": [
                { "key": "fields", "value": "id,name,programType,trackedEntityType[id,name],programTrackedEntityAttributes[mandatory,displayInList,sortOrder,trackedEntityAttribute[id,name,valueType,optionSet[id,name]]],programStages[id,name,programStageDataElements[compulsory,dataElement[id,name,valueType,optionSet[id,name]]]]" }
              ]
            },
            "description": "Full program structure: tracked entity attributes (registration fields) + program stage data elements (per-signal fields). See data/metadata/program.json for a cached copy."
          }
        },
        {
          "name": "Option set values",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/optionSets/{{optionSetId}}.json?fields=id,name,options[code,name]",
              "host": ["{{baseUrl}}"],
              "path": ["api", "optionSets", "{{optionSetId}}.json"],
              "query": [
                { "key": "fields", "value": "id,name,options[code,name]" }
              ]
            },
            "description": "Decodes an option set's codes to labels. Defaults to 'Signal Verification' (Confirmed/Discarded) - swap optionSetId for any other option set id from program.json (e.g. Disease, EBS Type, CR_Province)."
          }
        },
        {
          "name": "Org unit levels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/organisationUnitLevels.json?fields=id,name,level&order=level:asc&paging=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "organisationUnitLevels.json"],
              "query": [
                { "key": "fields", "value": "id,name,level" },
                { "key": "order", "value": "level:asc" },
                { "key": "paging", "value": "false" }
              ]
            },
            "description": "National > Province > District > Sub District > Sector > Facilities > Villages."
          }
        },
        {
          "name": "Org unit by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/organisationUnits/{{orgUnitId}}.json?fields=id,name,level,path,parent[id,name],contactPerson,phoneNumber,email",
              "host": ["{{baseUrl}}"],
              "path": ["api", "organisationUnits", "{{orgUnitId}}.json"],
              "query": [
                { "key": "fields", "value": "id,name,level,path,parent[id,name],contactPerson,phoneNumber,email" }
              ]
            },
            "description": "contactPerson/phoneNumber/email are populated for ~437 org units instance-wide, but NOT consistently - many facilities (including the ones in our sample data) have these blank."
          }
        },
        {
          "name": "Org units batch lookup (id:in filter)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/organisationUnits.json?filter=id:in:[{{orgUnitIdsCsv}}]&fields=id,name&paging=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "organisationUnits.json"],
              "query": [
                { "key": "filter", "value": "id:in:[{{orgUnitIdsCsv}}]" },
                { "key": "fields", "value": "id,name" },
                { "key": "paging", "value": "false" }
              ]
            },
            "description": "Batch-resolve many org unit ids to names in one call. Fill orgUnitIdsCsv with a comma-separated list. paging=false confirmed to return everything with no truncation, unlike the tracker/trackedEntities batch endpoint below."
          }
        }
      ]
    },
    {
      "name": "3. Tracker Data",
      "item": [
        {
          "name": "Tracked entities (original request)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/41/tracker/trackedEntities?program={{programId}}&orgUnits={{orgUnitId}}&orgUnitMode=DESCENDANTS&page=1&pageSize=100&fields=trackedEntity,orgUnit,attributes[attribute,value],enrollments[enrollment,program,status,events[dataValues[dataElement,value]]]",
              "host": ["{{baseUrl}}"],
              "path": ["api", "41", "tracker", "trackedEntities"],
              "query": [
                { "key": "program", "value": "{{programId}}" },
                { "key": "orgUnits", "value": "{{orgUnitId}}" },
                { "key": "orgUnitMode", "value": "DESCENDANTS" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "100" },
                { "key": "fields", "value": "trackedEntity,orgUnit,attributes[attribute,value],enrollments[enrollment,program,status,events[dataValues[dataElement,value]]]" }
              ]
            },
            "description": "This is the exact endpoint from the original task. ~48,826 tracked entities total nationwide (registered reporters/'lookouts'). Contains real PII (name, phone) - handle output accordingly."
          }
        },
        {
          "name": "Tracked entities - pager totals only",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/41/tracker/trackedEntities?program={{programId}}&orgUnits={{orgUnitId}}&orgUnitMode=DESCENDANTS&page=1&pageSize=1&totalPages=true&fields=trackedEntity",
              "host": ["{{baseUrl}}"],
              "path": ["api", "41", "tracker", "trackedEntities"],
              "query": [
                { "key": "program", "value": "{{programId}}" },
                { "key": "orgUnits", "value": "{{orgUnitId}}" },
                { "key": "orgUnitMode", "value": "DESCENDANTS" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "1" },
                { "key": "totalPages", "value": "true" },
                { "key": "fields", "value": "trackedEntity" }
              ]
            },
            "description": "Cheap way to check volume (total + pageCount) before pulling real data."
          }
        },
        {
          "name": "Tracked entities batch (reporter details lookup)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracker/trackedEntities?trackedEntities={{trackedEntityIdsCsv}}&program={{programId}}&fields=trackedEntity,attributes[attribute,value]&pageSize=100",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracker", "trackedEntities"],
              "query": [
                { "key": "trackedEntities", "value": "{{trackedEntityIdsCsv}}" },
                { "key": "program", "value": "{{programId}}" },
                { "key": "fields", "value": "trackedEntity,attributes[attribute,value]" },
                { "key": "pageSize", "value": "100" }
              ]
            },
            "description": "GOTCHA (found the hard way in monitor_open_signals.py): this endpoint defaults to pageSize=50 and SILENTLY TRUNCATES even when you pass more than 50 explicit ids in trackedEntities=. Always set pageSize >= number of ids requested."
          }
        },
        {
          "name": "Tracker events (all, paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracker/events?program={{programId}}&orgUnit={{orgUnitId}}&ouMode=DESCENDANTS&fields=event,trackedEntity,orgUnit,status,occurredAt,updatedAt,dataValues[dataElement,value]&pageSize=200&page=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracker", "events"],
              "query": [
                { "key": "program", "value": "{{programId}}" },
                { "key": "orgUnit", "value": "{{orgUnitId}}" },
                { "key": "ouMode", "value": "DESCENDANTS" },
                { "key": "fields", "value": "event,trackedEntity,orgUnit,status,occurredAt,updatedAt,dataValues[dataElement,value]" },
                { "key": "pageSize", "value": "200" },
                { "key": "page", "value": "1" }
              ]
            },
            "description": "Lighter-weight than trackedEntities when you only care about the signal events themselves (~867 total currently, not 48k+). This is what monitor_open_signals.py uses."
          }
        },
        {
          "name": "Tracker events - updated since a timestamp",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/tracker/events?program={{programId}}&orgUnit={{orgUnitId}}&ouMode=DESCENDANTS&updatedAfter={{updatedAfter}}&fields=event,updatedAt,dataValues[dataElement,value]&pageSize=200",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tracker", "events"],
              "query": [
                { "key": "program", "value": "{{programId}}" },
                { "key": "orgUnit", "value": "{{orgUnitId}}" },
                { "key": "ouMode", "value": "DESCENDANTS" },
                { "key": "updatedAfter", "value": "{{updatedAfter}}" },
                { "key": "fields", "value": "event,updatedAt,dataValues[dataElement,value]" },
                { "key": "pageSize", "value": "200" }
              ]
            },
            "description": "Fill updatedAfter with an ISO datetime in SERVER-LOCAL time (confirmed Africa/Kigali, UTC+2 - not UTC). Also supports updatedWithin=<duration> e.g. '6m' or '1440h' as an alternative to explicit timestamps - both confirmed working."
          }
        }
      ]
    },
    {
      "name": "4. Signal Routing Investigation (CEHO question)",
      "item": [
        {
          "name": "Program stage notification templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/programStages/{{programStageId}}.json?fields=id,name,enableUserAssignment,notificationTemplates[id,name,notificationRecipient,recipientUserGroup[id,name]]",
              "host": ["{{baseUrl}}"],
              "path": ["api", "programStages", "{{programStageId}}.json"],
              "query": [
                { "key": "fields", "value": "id,name,enableUserAssignment,notificationTemplates[id,name,notificationRecipient,recipientUserGroup[id,name]]" }
              ]
            },
            "description": "enableUserAssignment=false confirmed - DHIS2's native 'assign to a user' feature is off for this stage. Only one notification template is attached: 'Ubutumwa ecs'."
          }
        },
        {
          "name": "Notification template detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/programNotificationTemplates/{{notificationTemplateId}}.json?fields=id,name,notificationTrigger,notificationRecipient,recipientProgramAttribute[id,name],recipientDataElement[id,name],deliveryChannels,messageTemplate,subjectTemplate,notifyUsersInHierarchyOnly",
              "host": ["{{baseUrl}}"],
              "path": ["api", "programNotificationTemplates", "{{notificationTemplateId}}.json"],
              "query": [
                { "key": "fields", "value": "id,name,notificationTrigger,notificationRecipient,recipientProgramAttribute[id,name],recipientDataElement[id,name],deliveryChannels,messageTemplate,subjectTemplate,notifyUsersInHierarchyOnly" }
              ]
            },
            "description": "Confirmed: 'Ubutumwa ecs' sends an SMS back to the REPORTER's own Mobile number attribute on event COMPLETION - it's a confirmation message, not a routing/assignment notification to a CEHO or any responder."
          }
        },
        {
          "name": "All notification templates (system-wide)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/programNotificationTemplates.json?fields=id,name,program[id,name],notificationRecipient,recipientUserGroup[id,name]&paging=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "programNotificationTemplates.json"],
              "query": [
                { "key": "fields", "value": "id,name,program[id,name],notificationRecipient,recipientUserGroup[id,name]" },
                { "key": "paging", "value": "false" }
              ]
            },
            "description": "Other templates exist (National IDSR team, ESR Team, One Health teams, Covid-19 response team) but none are attached to the Impuruza CEBS program stage - see the previous request."
          }
        },
        {
          "name": "Search user roles/groups by name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/userRoles.json?filter=name:ilike:{{searchTerm}}&fields=id,name&paging=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "userRoles.json"],
              "query": [
                { "key": "filter", "value": "name:ilike:{{searchTerm}}" },
                { "key": "fields", "value": "id,name" },
                { "key": "paging", "value": "false" }
              ]
            },
            "description": "Swap searchTerm to probe for role/group names (tried: ceho, officer, environ, chw, cell health, hygiene - no CEHO-specific role found)."
          }
        }
      ]
    }
  ]
}
